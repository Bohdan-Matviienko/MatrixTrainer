<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.controller.Controller">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>


    <top>
        <Button fx:id="startButton" text="Почати" onAction="#start" BorderPane.alignment="CENTER"/>
    </top>


    <center>
        <HBox fx:id="center" visible="false" spacing="10" alignment="CENTER">
            <GridPane fx:id="matrixA" hgap="5" vgap="5" alignment="CENTER"/>
            <Label text=" * " style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <GridPane fx:id="matrixB" hgap="5" vgap="5" alignment="CENTER"/>
            <Label text=" = " style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

            <GridPane fx:id="matrixM" hgap="5" vgap="5" alignment="CENTER"/>
        </HBox>
    </center>


    <bottom>
        <VBox fx:id="bottom" visible="false" spacing="10" alignment="CENTER" BorderPane.alignment="CENTER">
            <padding>
                <Insets top="30"/>
            </padding>
            <Label fx:id="question" style="-fx-font-size: 16px;"/>

            <fx:define>
                <ToggleGroup fx:id="toggleGroup"/>
            </fx:define>

            <HBox spacing="20" alignment="CENTER">
                <RadioButton fx:id="radio1" text="Так" toggleGroup="$toggleGroup"/>
                <RadioButton fx:id="radio2" text="Ні" toggleGroup="$toggleGroup"/>
            </HBox>

            <Button text="Відповісти" onAction="#next"/>
        </VBox>
    </bottom>
</BorderPane>